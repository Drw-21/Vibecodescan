# Every environment variable the project uses. NO REAL VALUES IN THIS FILE, EVER.
# Copy to .env for local development. .env is git-ignored.

# --- Browser (web/) — only public values may start with VITE_ -------------
# The public Supabase URL and anon key. Safe in the browser because RLS protects every table.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Cloudflare Turnstile site key (public).
VITE_TURNSTILE_SITE_KEY=

# --- Edge Functions only — set with `supabase secrets set`, never in web/ --
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
TURNSTILE_SECRET_KEY=
LLM_API_KEY=
LEMONSQUEEZY_WEBHOOK_SECRET=
SENTRY_DSN=
# Public domain used in the scanner's User-Agent, e.g. ScannerBot/1.0 (+https://<domain>/bot)
SCANNER_BOT_DOMAIN=

# --- Tests only -------------------------------------------------------------
# A throwaway Postgres for the RLS tests. NEVER point this at production.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/scanner_test
